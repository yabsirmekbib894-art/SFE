# GEMINI_API_KEY: Required for Gemini AI API calls (OCR & question extraction).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model alias used for document processing and OCR (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ALLOWED_ORIGIN: CORS allowed origin for security headers (defaults to window origin or applet URL)
ALLOWED_ORIGIN="*"

# FIREBASE_SERVICE_ACCOUNT_KEY: JSON string of Firebase service account key (optional for local/standalone admin SDK)
FIREBASE_SERVICE_ACCOUNT_KEY=""
